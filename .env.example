# Copiá este archivo como ".env" (en la misma carpeta) y completá los valores.
# El archivo .env NO se sube a GitHub; este .env.example sí, como guía.

# "API environment variable" del panel de Cloudinary (Settings > API Keys)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Opcional: token para forzar la sincronización con POST /api/imagenes/sincronizar
SYNC_TOKEN=

# Contraseña de PostgreSQL usada por compose.prod.yaml (cambiala en producción)
DB_PASSWORD=
